;
; MSVC リンカ用のエクスポート定義ファイル。
; LIBRARY はインポートライブラリが参照する DLL 名になる。
; CMakeLists.txt の FMGEN_OUTPUT_NAME と違うと configure で止まる。

LIBRARY "FmGenEngine"

EXPORTS
    FmEngine_Create
    FmEngine_Destroy
    FmEngine_Inquiry
    FmEngine_GetSupportedChip
    FmEngine_AddChip
    FmEngine_GetChipName
    FmEngine_GetNativeRate
    FmEngine_GetSampleRate
    FmEngine_Write
    FmEngine_SetGain
    FmEngine_GetGain
    FmEngine_SetPartGain
    FmEngine_GetPartGain
    FmEngine_GetPartMask
    FmEngine_SetMemory
    FmEngine_GetMemorySize
    FmEngine_SetMemoryEx
    FmEngine_Generate
